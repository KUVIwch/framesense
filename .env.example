# 云知声 API 配置（仅本地使用，切勿提交真实密钥）
UNISOUND_API_KEY=
UNISOUND_API_BASE_URL=https://your-unisound-endpoint.example.com
UNISOUND_MODEL=vision-model-name

# AI 模式：mock | unisound（默认 mock，不产生网络/API 费用）
FRAMESENSE_AI_MODE=mock
FRAMESENSE_REQUEST_TIMEOUT=30
FRAMESENSE_MAX_RETRIES=2

# 调色视觉模型（OpenAI 兼容接口，可选；默认 mock 不产生网络调用）
# 云知声 MaaS 示例：
#   OPENAI_BASE_URL=https://maas-api.unisound.com/v1
#   OPENAI_MODEL=u2-flash
FRAMESENSE_VISION_MODE=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
FRAMESENSE_JSON_MODE=true
FRAMESENSE_MAX_TOKENS=4000
FRAMESENSE_REQUEST_TIMEOUT=300
FRAMESENSE_MAX_RETRIES=0

# 可选：文字整理模型（用于格式修复等纯文本任务；不填则复用 OPENAI_MODEL）
OPENAI_TEXT_MODEL=
# 可选：推理强度 none | low | medium | high（部分模型支持）
FRAMESENSE_REASONING_EFFORT=
# 可选：SQLite 数据库路径（默认 data/framesense.db）
FRAMESENSE_DB_PATH=
